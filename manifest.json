{
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "version": "0.1.0",
  "manifest_version": 3,
  "default_locale": "pt_BR",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "alarms"
  ],
  "icons": {
    "16": "tag-16.png",
    "32": "tag-32.png",
    "48": "tag-48.png",
    "128": "tag-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "tag-16.png",
      "32": "tag-32.png"
    }
  }
}
